# The image is built from source, so the source tree must reach the build
# context. Only host-local artifacts, VCS metadata and secrets are excluded.

# VCS metadata — the build reads files, not history.
.git
.gitignore

# Dependencies and build output produced on the host. These are re-created
# inside the image; shipping the host's copies would be slow and, for native
# modules, wrong for the target platform.
**/node_modules
**/dist
**/lib
**/target
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*

# Test, coverage and browser artifacts.
**/coverage
**/test-results
**/playwright-report
.coverage
.nyc_output
.playwright-browsers

# Local secrets never belong in a build context.
.env
**/.env.local
**/.env.*.local

# OS noise.
.DS_Store
Thumbs.db
